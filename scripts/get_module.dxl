// get_module: returns module metadata as JSON.
string path = {{.path}}
string baselineId = {{.baselineId}}

Module m = open(path, false)
string result

if (m == null) {
	string emsg = "module not found: " path
	result = jerr(emsg)
} else {
	result = "{\"status\":\"ok\",\"data\":{"
	result = result "\"id\":"
	result = result jstr(uniqueID(m))
	result = result ","
	result = result "\"name\":"
	result = result jstr(name(m))
	result = result ","
	result = result "\"path\":"
	result = result jstr(fullName(m))
	result = result ","
	result = result "\"baselineId\":"
	result = result jstr(baselineId)
	result = result ","
	result = result "\"createdOn\":"
	result = result jstr("")
	result = result ","
	result = result "\"modifiedOn\":"
	result = result jstr("")
	result = result "}}"
}

return_ = result
