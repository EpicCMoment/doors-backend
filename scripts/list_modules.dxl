// list_modules: modules directly under the given path prefix.
string path = {{.path}}

string result = "{\"status\":\"ok\",\"data\":["
Module m
bool first = true
int count = 0

for m in all Modules do {
	string fn = fullName(m)
	if (length(fn) > length(path) && fn[0:length(path)] == path) {
		if (!first) {
			result = result ","
		}
		first = false
		count++
		result = result "{\"id\":"
		result = result jstr(uniqueID(m))
		result = result ",\"name\":"
		result = result jstr(name(m))
		result = result ",\"path\":"
		result = result jstr(fn)
		result = result ",\"baselineId\":\"\""
		result = result "}"
	}
}

result = result "]}"
return_ = result
