// get_requirements: requirements of a module (current or baseline view).
string modulePath = {{.modulePath}}
string baselineId = {{.baselineId}}

Module m = open(modulePath, false)
string result

if (m == null) {
	result = jerr("module not found: " + modulePath)
} else {
	bool ok = true
	if (baselineId != "") {
		Baseline b
		ok = false
		for b in m do {
			if (baselineName(b) == baselineId) {
				ok = true
				load(b, true)
				break
			}
		}
	}
	if (!ok) {
		result = jerr("baseline not found: " + baselineId)
	} else {
		result = "{\"status\":\"ok\",\"data\":["
		Object o
		bool first = true
		for o in m do {
			if (!first) {
				result = result + ","
			}
			first = false
			result = result + "{\"id\":" + jstr(intToStr(o."Object Number"))
				+ ",\"modulePath\":" + jstr(modulePath)
				+ ",\"baselineId\":" + jstr(baselineId)
				+ ",\"heading\":" + jstr(o."Object Heading")
				+ ",\"text\":" + jstr(o."Object Text")
				+ ",\"attributes\":{}"
				+ "}"
		}
		result = result + "]}"
	}
}

return_ = result
