// get_baselines: baseline names of a module.
// Best-effort against DXL 9.7 docs; the exact baseline-enumeration builtin
// must be confirmed on a real DOORS host.
string moduleId = {{.moduleId}}

Module m = open(moduleId, false)
string result

if (m == null) {
	result = jerr("module not found: " + moduleId)
} else {
	result = "{\"status\":\"ok\",\"data\":[]}"
	// TODO: enumerate baseline names once the correct DXL builtin is
	// confirmed on the DOORS 9.7 host (candidates: baseline enumeration via
	// module attributes / Baselines link).
}

return_ = result
