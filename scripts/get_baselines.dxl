// get_baselines: baseline names of a module.
string moduleId = {{.moduleId}}

Module m = open(moduleId, false)
string result

if (m == null) {
	result = jerr("module not found: " + moduleId)
} else {
	result = "{\"status\":\"ok\",\"data\":["
	Baseline b
	bool first = true
	for b in m do {
		if (!first) {
			result = result + ","
		}
		first = false
		result = result + "{\"id\":" + jstr(baselineName(b))
			+ ",\"moduleId\":" + jstr(moduleId)
			+ ",\"name\":" + jstr(baselineName(b))
			+ ",\"createdOn\":" + jstr("")
			+ ",\"comment\":" + jstr(annotation(b))
			+ "}"
	}
	result = result + "]}"
}

return_ = result
