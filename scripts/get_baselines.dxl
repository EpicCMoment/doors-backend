// get_baselines: baseline names of a module.
string modulePath = {{.modulePath}}

Module m = open(modulePath, false)
string result

if (m == null) {
	result = jerr("module not found: " + modulePath)
} else {
	result = "{\"status\":\"ok\",\"data\":["
	Baseline b
	bool first = true
	for b in m do {
		if (!first) {
			result = result + ","
		}
		first = false
		result = result + "{\"id\":" + jstr(baselineName(b))
			+ ",\"modulePath\":" + jstr(modulePath)
			+ ",\"name\":" + jstr(baselineName(b))
			+ ",\"createdOn\":" + jstr("")
			+ ",\"comment\":" + jstr(annotation(b))
			+ "}"
	}
	result = result + "]}"
}

return_ = result
