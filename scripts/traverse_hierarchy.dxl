// traverse_hierarchy: flat requirement outline with parent links and levels.
string modulePath = {{.modulePath}}
string baselineId = {{.baselineId}}

Module m = open(modulePath, false)
string result

if (m == null) {
	string emsg = "module not found: " modulePath
	result = jerr(emsg)
} else {
	Module target = m
	bool ok = true
	if (baselineId != "") {
		Baseline b
		ok = false
		for b in m do {
			if (baselineName(b) == baselineId) {
				ok = true
				target = load(m, b, false)
				break
			}
		}
	}
	if (!ok) {
		string bld = "baseline not found: " baselineId
		result = jerr(bld)
	} else {
		result = "{\"status\":\"ok\",\"data\":["
		Object o
		bool first = true
		for o in target do {
			if (!first) {
				result = result ","
			}
			first = false
			result = result "{\"id\":"
			result = result jstr(intToStr(o."Object Number"))
			result = result ",\"modulePath\":"
			result = result jstr(modulePath)
			result = result ",\"baselineId\":"
			result = result jstr(baselineId)
			result = result ",\"parentId\":\"\""
			result = result ",\"level\":"
			result = result intToStr(o."Level")
			result = result ",\"heading\":"
			result = result jstr(o."Object Heading")
			result = result "}"
		}
		result = result "]}"
	}
}

return_ = result
