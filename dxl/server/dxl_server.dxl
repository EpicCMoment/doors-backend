// dxl_server.dxl
// TCP server running inside a background DOORS process.
// Protocol: one client connection per request.
//   Client -> Server : a DXL code string (templated script, fully rendered)
//   Server -> Client : the JSON string the script assigned to return_.
//                       Utility scripts set return_ to their JSON envelope
//                       ({"status":...}); on eval_ failure the server
//                       returns a JSON error envelope.
// Magic request strings:
//   "shutdown_" -> graceful server stop (replies "done_")

IPC ipc = server {{.Port}}
string request
string ans

while (true) {
	if (accept(ipc)) {
		if (!recv(ipc, request)) {
			warn "client disconnected before sending"
			disconnect(ipc)
			continue
		}
	} else {
		warn "error accepting client connection"
		break
	}


	if (request == "shutdown_") {
		send(ipc, "done_")
		disconnect(ipc)
		break
	}

	return_ = ""
	ans = eval_ request
	if (ans == "errors in eval_ string") {
		print "errors in request\n"
		ans = "{\"status\":\"error\",\"message\":\"errors in eval_ string\"}"
	} else if (return_ == "") {
		ans = "{\"status\":\"error\",\"message\":\"script did not assign return_\"}"
	} else {
		ans = return_
	}
	// reset for the next request
	return_ = ""
	send(ipc, ans)
	disconnect(ipc)
}
